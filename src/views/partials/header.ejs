<header class="site-header">
  <a class="brand" href="/" aria-label="Ir a Home">
    <span class="brand__logo" aria-hidden="true">ME</span>
    <span class="brand__name">Mi Ecommerce</span>
  </a>

  <form class="search" role="search" action="/search" method="GET" aria-label="Buscar productos">
    <label class="sr-only" for="site-search">Buscar productos</label>
    <input id="site-search" name="query" type="search" placeholder="Buscar productos" value="<%= typeof query !== 'undefined' ? query : '' %>">
    <button type="submit">Buscar</button>
  </form>

  <nav class="main-nav" aria-label="Navegación principal">
    <a href="/">Home</a>
    <a href="/products">Productos</a>
    <a href="/cart">Carrito (<span id="cart-count"><%= typeof cartQuantity !== 'undefined' ? cartQuantity : 0 %></span>)</a>
    <a href="/login">Login</a>
    <a href="/register">Register</a>
  </nav>
  <p id="connection-status" class="connection-status" role="status" aria-live="polite">🔴 Desconectado</p>
</header>
