<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= typeof title !== 'undefined' && title ? `${title} | Mi Ecommerce` : 'Mi Ecommerce' %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <%- include('../partials/header') %>
  <div id="cart-notification" class="cart-notification" role="status" aria-live="polite" hidden></div>
  <main>
    <%- body %>
  </main>
  <%- include('../partials/footer') %>
  <script src="/js/websocket.js" defer></script>
</body>
</html>
