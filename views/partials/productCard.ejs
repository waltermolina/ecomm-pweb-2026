<article class="product-card">
  <a href="/products" aria-label="Ver detalle de <%= product.name %>">
    <img src="<%= product.image %>" alt="Imagen de <%= product.name %>">
    <div class="product-card__body">
      <h3><%= product.name %></h3>
      <p><%= product.points %> puntos</p>
    </div>
  </a>
</article>
