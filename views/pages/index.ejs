<%- include('../partials/header', { title: 'Home' }) %>

<section class="hero" aria-labelledby="home-title">
  <div>
    <p class="eyebrow">Tienda ficticia</p>
    <h1 id="home-title">Canjeá productos con tus puntos</h1>
    <p>Ejemplo de ecommerce monolítico renderizado desde el servidor con Express y EJS.</p>
  </div>
  <a class="button button--secondary" href="/cart">Ver carrito</a>
</section>

<section class="section" aria-labelledby="categories-title">
  <h2 id="categories-title">Categorías</h2>
  <div class="categories">
    <a href="/products">Categoría 1</a>
    <a href="/products">Categoría 2</a>
    <a href="/products">Categoría 3</a>
  </div>
</section>

<section class="section" aria-labelledby="products-title">
  <h2 id="products-title">Productos</h2>
  <div class="product-grid">
    <% products.forEach((product) => { %>
      <%- include('../partials/productCard', { product }) %>
    <% }) %>
  </div>
</section>

<%- include('../partials/footer') %>
