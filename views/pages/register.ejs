<%- include('../partials/header', { title: 'Register' }) %>

<section class="auth-page" aria-labelledby="register-title">
  <form class="auth-form">
    <h1 id="register-title">Registrarse</h1>

    <div class="form-field">
      <label for="register-name">Nombre</label>
      <input id="register-name" name="name" type="text" autocomplete="name" required>
    </div>

    <div class="form-field">
      <label for="register-email">Email</label>
      <input id="register-email" name="email" type="email" autocomplete="email" required>
    </div>

    <div class="form-field">
      <label for="register-password">Contraseña</label>
      <input id="register-password" name="password" type="password" autocomplete="new-password" required>
    </div>

    <button type="submit" class="button">Registrarse</button>

    <p>¿Ya tenés cuenta? <a href="/login">Ir a Login</a></p>
    <p><a href="/">Volver a Home</a></p>
  </form>
</section>

<%- include('../partials/footer') %>
